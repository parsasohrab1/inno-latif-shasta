# نمونه تنظیمات محیطی برای سرور لطیف
# کپی کنید به `.env` و مقادیر را تنظیم کنید: cp app/.env.example app/.env

LATIF_HOST=0.0.0.0
LATIF_PORT=8000

# شبیه‌ساز OPC-UA
LATIF_OPCUA_SIM_ENABLED=true
LATIF_OPCUA_INTERVAL_SEC=5
LATIF_OPCUA_SEED=42

# Historian
LATIF_HISTORIAN_BACKEND=memory
LATIF_HISTORIAN_PATH=/tmp/latif_historian.sqlite
LATIF_HISTORIAN_RETENTION_HOURS=24

# MPC
LATIF_MPC_HORIZON=3
LATIF_MPC_MAX_ITERS=30
LATIF_MPC_AUTO_APPLY=false
